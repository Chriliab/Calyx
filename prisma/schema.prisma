generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}


model Consultant {
    id        String   @id
    email     String   @unique
    name      String
    slug      String   @unique
    timezone  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    sessionTypes SessionType[]
    availabilityRules AvailabilityRule[]
    bookings Booking[]

}

model SessionType {
  id              String   @id @default(cuid())
  consultantId    String
  consultant      Consultant @relation(fields: [consultantId], references: [id])
  title           String
  durationMinutes Int
  priceCents      Int
  currency        String   @default("EUR")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([consultantId])
  bookings Booking[]
}

model AvailabilityRule {
  id           String   @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  dayOfWeek    Int
  startMinute  Int
  endMinute    Int
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
}

model Client {
  id        String   @id @default(cuid())
  email     String
  name      String
  bookings  Booking[]
  createdAt DateTime @default(now())

  @@index([email])
}

model Booking {
  id                 String   @id @default(cuid())
  consultantId       String
  consultant         Consultant @relation(fields: [consultantId], references: [id])
  sessionTypeId      String
  sessionType        SessionType @relation(fields: [sessionTypeId], references: [id])
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])

  startsAt           DateTime
  endsAt             DateTime
  status             BookingStatus @default(PENDING)

  priceAtBooking     Int
  currencyAtBooking  String

  projectDescription String
  budgetRange        String
  timeline           String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([consultantId])
  @@index([consultantId, startsAt])
  @@index([status])
  payment Payment?

}


model Payment {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  booking               Booking  @relation(fields: [bookingId], references: [id])

  stripeSessionId       String   @unique
  stripePaymentIntentId String?

  amountCents           Int
  currency              String
  status                PaymentStatus @default(PENDING)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}